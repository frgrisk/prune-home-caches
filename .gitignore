# Copyright 2026 The Financial Risk Group, Inc.

# Claude Code: ignore local/user-specific files only. The shared
# .claude/settings.json is deliberately committed. Do not ignore it.
.claude/*.local.*
.claude/todos/
.claude/worktrees/
.superpowers/

# Python: dependencies are managed with uv
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# rpmbuild's _topdir points at ./rpmbuild, so local builds land in the checkout.
rpmbuild/
*.rpm

# Node
node_modules/

# Editors and tooling
.vscode/
.idea/copilot*
.playwright-mcp/
.playwright-cli/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*.lnk
*Zone.Identifier
